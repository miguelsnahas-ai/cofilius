# Copie para .env e preencha. O .env nunca vai para o git.

# Conexão com o Postgres do Supabase.
# Supabase > Project Settings > Database > Connection string > "Session pooler" (URI).
# Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave mestra que cifra as credenciais dos clientes na tabela `credenciais`.
# 32 bytes em base64. Gere com: npm run gerar-chave
# Se perder esta chave, as credenciais gravadas não podem ser lidas (é só gravar de novo).
CREDENCIAIS_CHAVE=

# Credenciais da Shopee Affiliate Open API (painel de afiliados > Open API).
# Usadas SÓ pelo comando `npm run cli -- credenciais-shopee`, que as grava cifradas
# na tabela `credenciais`. Depois disso, pode apagá-las daqui.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Opcional. Endpoint do Brasil (padrão abaixo).
# SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# Opcional. Nível de log: debug | info | warn | error (padrão: info)
# LOG_NIVEL=info

# Agentes de IA. Dá para configurar tudo pela aba Configuração do painel.
# Provedor: gemini (padrão, nível gratuito) ou claude (pago).
# IA_PROVEDOR=gemini
# Gemini: chave grátis em aistudio.google.com ("Get API key"). No nível gratuito, o Google pode usar
# o conteúdo enviado para melhorar os produtos dele, e há limite de chamadas por minuto e por dia.
GEMINI_API_KEY=
# Claude: chave em platform.claude.com (créditos pré-pagos).
# ANTHROPIC_API_KEY=
# Opcional: modelo de cada porte. Sem nada aqui, valem os padrões do provedor
# (Gemini: gemini-3.5-flash-lite e gemini-4-hydrogen; Claude: claude-haiku-5-5).
# "pequeno": Redator e Atendente. "forte": Curador e Analista.
# MODELO_IA_PEQUENO=
# MODELO_IA_FORTE=
# Opcional: preço por milhão de tokens em US$ ("entrada,saida") de um modelo fora dos padrões.
# MODELO_IA_PEQUENO_PRECO=
# MODELO_IA_FORTE_PRECO=

# Painel do operador (npm run painel → http://127.0.0.1:3000).
# Senha pedida pelo navegador (usuário: qualquer). Obrigatória.
PAINEL_SENHA=
# Nome gravado como quem aprovou cada mensagem.
PAINEL_OPERADOR=Miguel
# Opcional: porta e endereço. Por padrão, só este computador acessa (127.0.0.1).
# PAINEL_PORTA=3000
# PAINEL_HOST=127.0.0.1

# WhatsApp Cloud API (Meta) — quando o número do serviço estiver aprovado. Sem isto, o envio é manual.
# Os formatos da API ainda precisam ser conferidos (veja TODO(whatsapp-doc) em services/disparador/whatsapp.ts).
# WHATSAPP_TOKEN=
# WHATSAPP_NUMERO_ID=
# WHATSAPP_VERSAO_API=
# Segredo do app (confere a assinatura dos avisos) e o texto de verificação definido no painel da Meta.
# WHATSAPP_SEGREDO_APP=
# WHATSAPP_TOKEN_VERIFICACAO=
# WEBHOOK_PORTA=8787
