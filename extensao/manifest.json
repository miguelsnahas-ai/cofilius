{
  "manifest_version": 3,
  "name": "Cofilius · Gravador",
  "version": "0.1.0",
  "description": "Grava os dados que as páginas de afiliado do Mercado Livre carregam, para o Cofilius entender o formato.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "servico.js"
  },
  "action": {
    "default_title": "Cofilius · Gravador",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*"
      ],
      "js": [
        "nucleo.js",
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
